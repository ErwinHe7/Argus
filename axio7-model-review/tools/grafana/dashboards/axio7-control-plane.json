    {
      "id": 1,
      "type": "table",
      "title": "Fail-closed 闸门链 — 第一个 BLOCKED 之后的一切都不可达",
      "description": "闸门按执行顺序排列。UNREACHABLE 不代表通过，代表上游已经拦住、根本没跑到。",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "axio7"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/api/v1/system/readiness",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "gates",
          "columns": [
            {
              "selector": "order",
              "text": "#",
              "type": "string"
            },
            {
              "selector": "gate",
              "text": "闸门",
              "type": "string"
            },
            {
              "selector": "status",
              "text": "状态",
              "type": "string"
            },
            {
              "selector": "detail",
              "text": "说明",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "#"
            },
            "properties": [
              {
                "id": "custom.width",
