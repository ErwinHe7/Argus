{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interview-scout",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  // Served free at https://interview-scout.<your-subdomain>.workers.dev; CI can also attach a custom domain.
  "workers_dev": true,
  "assets": { "directory": "./public" },
  // Cloudflare Browser Rendering: the headless Chrome the agent fills forms with.
  "browser": { "binding": "BROWSER" },
  // Hunt inputs, progress and screenshots in the namespace provisioned for this Worker.
  "kv_namespaces": [{ "binding": "HUNTS", "id": "e8912c55cd8a462ab0cc514cf44f8621" }],
  // Background hunts keep applying after the browser tab is closed.
  "workflows": [
    { "name": "interview-scout-hunts", "binding": "HUNT", "class_name": "HuntWorkflow", "concurrency": { "limit": 2 } }
  ],
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash-lite" },
  // Secrets GEMINI_API_KEY and ACCESS_CODE are uploaded by CI (or `wrangler secret put`).
  // Until both exist the API answers 401, so a first deploy without them is safe.
  "observability": { "enabled": true }
}
