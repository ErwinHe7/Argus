-- Run this in the Neon SQL Editor while connected to the intended
-- RitualInvesting branch and neondb as neondb_owner. Replace every password
-- locally before execution. Never save the populated version in this repository.
--
-- These roles must be created with SQL. Roles created through the Neon Console,
-- CLI, or API receive neon_superuser membership and are unsuitable for runtime.

CREATE ROLE ritual_identity_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<IDENTITY_PASSWORD>';
CREATE ROLE ritual_bootstrap_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<BOOTSTRAP_PASSWORD>';
CREATE ROLE ritual_staff_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<STAFF_PASSWORD>';
CREATE ROLE ritual_public_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<PUBLIC_PASSWORD>';
CREATE ROLE ritual_runtime_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<RUNTIME_PASSWORD>';
CREATE ROLE ritual_scheduler_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<SCHEDULER_PASSWORD>';
CREATE ROLE ritual_privacy_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<PRIVACY_PASSWORD>';
CREATE ROLE ritual_media_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<MEDIA_PASSWORD>';
CREATE ROLE ritual_audit_login WITH LOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD '<AUDIT_PASSWORD>';

GRANT ritual_identity_resolver TO ritual_identity_login WITH INHERIT FALSE, SET TRUE;
GRANT ritual_bootstrap TO ritual_bootstrap_login WITH INHERIT FALSE, SET TRUE;
GRANT ritual_staff, ritual_staff_resolver TO ritual_staff_login WITH INHERIT FALSE, SET TRUE;
GRANT ritual_public TO ritual_public_login WITH INHERIT FALSE, SET TRUE;
GRANT ritual_runtime TO ritual_runtime_login WITH INHERIT FALSE, SET TRUE;
GRANT ritual_scheduler TO ritual_scheduler_login WITH INHERIT FALSE, SET TRUE;
GRANT ritual_privacy_purge TO ritual_privacy_login WITH INHERIT FALSE, SET TRUE;
GRANT ritual_media_worker TO ritual_media_login WITH INHERIT FALSE, SET TRUE;
GRANT ritual_audit_reconciler TO ritual_audit_login WITH INHERIT FALSE, SET TRUE;

-- Expect LOGIN=true, BYPASSRLS=false, SUPERUSER=false, CREATEDB=false,
-- CREATEROLE=false, REPLICATION=false for every *_login role.
SELECT rolname, rolcanlogin, rolsuper, rolcreatedb, rolcreaterole,
       rolreplication, rolbypassrls
FROM pg_roles
WHERE rolname LIKE 'ritual\_%\_login' ESCAPE '\'
ORDER BY rolname;

-- Expect only the capability grants above, each with SET=true and INHERIT=false.
SELECT roleid::regrole AS capability_role,
       member::regrole AS login_role,
       inherit_option,
       set_option
FROM pg_auth_members
WHERE member::regrole::text LIKE 'ritual\_%\_login' ESCAPE '\'
ORDER BY login_role, capability_role;
