{
  "schema_version": 1,
  "alerts": [
    {
      "id": "http-error-rate",
      "metric": "http.error_ratio",
      "comparison": "gte",
      "threshold": 0.01,
      "severity": "critical",
      "window": "5m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    },
    {
      "id": "http-latency",
      "metric": "http.latency.p95_ms",
      "comparison": "gte",
      "threshold": 1000,
      "severity": "warning",
      "window": "5m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    },
    {
      "id": "rate-limit-spike",
      "metric": "http.rate_limited_ratio",
      "comparison": "gte",
      "threshold": 0.1,
      "severity": "warning",
      "window": "5m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    },
    {
      "id": "auth-denial-rate",
      "metric": "http.authorization_denial_ratio",
      "comparison": "gte",
      "threshold": 0.05,
      "severity": "warning",
      "window": "5m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    },
    {
      "id": "dependency-outage",
      "metric": "dependency.available",
      "comparison": "lte",
      "threshold": 0,
      "severity": "critical",
      "window": "1m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    },
    {
      "id": "auth0-health",
      "metric": "auth0.available",
      "comparison": "lte",
      "threshold": 0,
      "severity": "critical",
      "window": "1m",
      "runbook": "docs/ritual-investing/auth0-setup.md"
    },
    {
      "id": "neon-health",
      "metric": "neon.available",
      "comparison": "lte",
      "threshold": 0,
      "severity": "critical",
      "window": "1m",
      "runbook": "docs/ritual-investing/neon-runbook.md"
    },
    {
      "id": "queue-backlog-age",
      "metric": "queue.oldest_age_seconds",
      "comparison": "gte",
      "threshold": 300,
      "severity": "critical",
      "window": "5m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    },
    {
      "id": "dlq-depth",
      "metric": "queue.dlq.depth",
      "comparison": "gte",
      "threshold": 1,
      "severity": "critical",
      "window": "1m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    },
    {
      "id": "media-quarantine-age",
      "metric": "media.quarantine.oldest_age_seconds",
      "comparison": "gte",
      "threshold": 3600,
      "severity": "critical",
      "window": "5m",
      "runbook": "docs/ritual-investing/admin-operations-runbook.md"
    },
    {
      "id": "privacy-purge-deadline",
      "metric": "privacy.purge.oldest_age_seconds",
      "comparison": "gte",
      "threshold": 2592000,
      "severity": "critical",
      "window": "1h",
      "runbook": "docs/ritual-investing/privacy-runbook.md"
    },
    {
      "id": "publication-failure",
      "metric": "editorial.publication.failures",
      "comparison": "gte",
      "threshold": 1,
      "severity": "critical",
      "window": "5m",
      "runbook": "docs/ritual-investing/admin-operations-runbook.md"
    },
    {
      "id": "cache-purge-failure",
      "metric": "editorial.cache_purge.failures",
      "comparison": "gte",
      "threshold": 1,
      "severity": "critical",
      "window": "5m",
      "runbook": "docs/ritual-investing/admin-operations-runbook.md"
    },
    {
      "id": "audit-parity",
      "metric": "admin.audit.parity_failures",
      "comparison": "gte",
      "threshold": 1,
      "severity": "critical",
      "window": "5m",
      "runbook": "docs/ritual-investing/admin-operations-runbook.md"
    },
    {
      "id": "rls-denial-spike",
      "metric": "database.rls_denials",
      "comparison": "gte",
      "threshold": 10,
      "severity": "warning",
      "window": "5m",
      "runbook": "docs/ritual-investing/neon-runbook.md"
    },
    {
      "id": "idempotency-conflict-spike",
      "metric": "commands.idempotency_conflicts",
      "comparison": "gte",
      "threshold": 20,
      "severity": "warning",
      "window": "5m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    },
    {
      "id": "stale-work-rejection-spike",
      "metric": "queue.stale_work_rejections",
      "comparison": "gte",
      "threshold": 20,
      "severity": "warning",
      "window": "5m",
      "runbook": "docs/ritual-investing/cloudflare-runbook.md"
    }
  ]
}
