{
  "name": "@ritual-investing/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:generate": "node --experimental-strip-types scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate -- --check",
    "client:generate": "node scripts/generate-client.mjs",
    "drift:check": "node --experimental-strip-types scripts/check-openapi-drift.ts",
    "cutover:check": "../scripts/check-legacy-backend-removal.sh"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.1",
    "hono": "4.13.3",
    "jose": "^6.2.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
