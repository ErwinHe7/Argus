{
  "name": "leo-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:leo-app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-leo-app.ps1",
    "quant:dev": "powershell -ExecutionPolicy Bypass -File scripts/start-intraday-quant.ps1",
    "quant:open": "powershell -ExecutionPolicy Bypass -File scripts/open-intraday-quant.ps1",
    "quant:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-intraday-quant.ps1",
    "quant:broker:start": "powershell -ExecutionPolicy Bypass -File scripts/start-moomoo-trade-gateway.ps1",
    "quant:broker:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-moomoo-trade-gateway.ps1",
    "quant:context:sync": "node --env-file=.env.local scripts/sync-official-context.mjs",
    "quant:data:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-quant-data.ps1",
    "quant:data:refresh:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-quant-data.ps1 -DryRun",
    "quant:build": "powershell -NoProfile -Command \"& $env:USERPROFILE/.cargo/bin/cargo.exe build --release --manifest-path quant_engine_rs/Cargo.toml\"",
    "quant:test": "powershell -NoProfile -Command \"& $env:USERPROFILE/.cargo/bin/cargo.exe test --manifest-path quant_engine_rs/Cargo.toml\"",
    "test:quant-conversation": "node --test scripts/quant-conversation-contract.test.mjs",
    "test:production-readiness": "tsx --test scripts/production-readiness-status.test.ts",
    "test:public-context": "tsx --test scripts/public-context-contract.test.ts",
    "test:ui-navigation": "node --test scripts/ui-navigation-contract.test.mjs",
    "test:paddle-catalog": "node --test scripts/paddle-catalog-contract.test.mjs",
    "test:growth-funnel": "tsx --test scripts/acquisition-attribution-contract.test.ts",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "paddle:catalog": "node scripts/provision-paddle-catalog.mjs",
    "paddle:live-infra": "node scripts/provision-paddle-live-infrastructure.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@langchain/core": "^1.1.40",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint-redis": "^1.0.4",
    "@langchain/openai": "^1.4.4",
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@sentry/nextjs": "^10.50.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "langfuse": "^3.38.20",
    "lucide-react": "^0.454.0",
    "next": "^14.2.35",
    "openai": "^4.68.0",
    "posthog-js": "^1.372.1",
    "posthog-node": "^5.30.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.14.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "pg": "^8.20.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.6",
    "typescript": "^5.5.0",
    "wrangler": "4.127.1"
  }
}
