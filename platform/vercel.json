{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/market-strategy",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/global-signal-alerts",
      "schedule": "30 12 * * 1-5"
    }
  ],
  "functions": {
    "app/api/cron/market-strategy/route.ts": { "maxDuration": 60 },
    "app/api/cron/global-signal-alerts/route.ts": { "maxDuration": 30 },
    "app/api/cron/market-monitors/route.ts": { "maxDuration": 300 },
    "app/api/market/research/route.ts": { "maxDuration": 30 },
    "app/api/strategy/run/route.ts": { "maxDuration": 60 },
    "app/api/strategy/execute/route.ts": { "maxDuration": 60 },
    "app/api/quant/ml-ls/route.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
