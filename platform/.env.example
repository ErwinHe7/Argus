# --- Supabase (free tier: https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Admin moderation ---
# gh2722@columbia.edu is always treated as an admin in code; add more comma-separated emails here.
ADMIN_EMAILS=gh2722@columbia.edu

# --- LLM (TokenRouter, OpenAI-compatible) ---
# Paste base URL + key from https://www.tokenrouter.com/console/token
OPENAI_BASE_URL=https://api.tokenrouter.com/v1
OPENAI_API_KEY=tr-xxxxxxxxxxxxxxxxxxxxxxxx
# TokenRouter model names are `provider/model` form. Make sure your distribution
# group in the TokenRouter console has ALL seven below enabled, because the
# 7-agent fanout uses them per persona:
#   openai/gpt-4o-mini           (Nova)
#   anthropic/claude-haiku-4.5   (Atlas)
#   deepseek/deepseek-v3.2       (Lumen)
#   moonshotai/kimi-k2.5         (Ember)
#   qwen/qwen3.6-plus            (Sage)
#   x-ai/grok-4.1-fast           (Mercer)
#   google/gemini-3-flash-preview (Iris)
OPENAI_MODEL=openai/gpt-4o-mini
# Optional: override the fallback chain (cheapest/most-stable first).
# OPENAI_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-haiku-4.5,deepseek/deepseek-v3.2,google/gemini-3-flash-preview,moonshotai/kimi-k2.5,qwen/qwen3.6-plus,x-ai/grok-4.1-fast

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://axio7.com
# Server-only canonical public origin used for payment redirects and same-origin checks.
AXIO7_SITE_URL=https://axio7.com

# --- Active billing provider ---
# Use `stripe`, `lemonsqueezy`, or `paddle`. Keep production on an approved, fully
# verified provider account; changing this value switches all Subscribe forms.
BILLING_PROVIDER=paddle

# --- Stripe billing ---
# Use test-mode values first, then replace all four with live-mode values together.
# Hosted Checkout does not expose the secret key or card data to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxxxx
# Test subscriptions must never grant production access. Enable only in an
# isolated local or preview environment when explicitly testing entitlements.
STRIPE_ALLOW_SANDBOX_ACCESS=false
# Hosted Checkout does not currently require this browser key, but keep it paired
# with the secret key if Stripe.js or an embedded flow is added later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Enable only after Stripe Tax is registered/configured for this account.
STRIPE_AUTOMATIC_TAX=false

# --- Lemon Squeezy billing (non-US sellers can complete the applicable W-8) ---
# API keys, stores, products, variants and webhooks are isolated between test
# and live mode. Never reuse test Variant IDs after activating the live store.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_PREMIUM=
LEMONSQUEEZY_VARIANT_ENTERPRISE=
# Safe default is true. Set false only after the store and live products are approved.
LEMONSQUEEZY_TEST_MODE=true
# Test subscriptions must not grant production access.
LEMONSQUEEZY_ALLOW_TEST_ACCESS=false

# --- Paddle Billing (merchant of record) ---
# REQUIRED: set exactly `sandbox` or `live`. Application code must fail loudly
# when this is empty; it must never silently choose an account/environment.
PADDLE_ENVIRONMENT=
# Server-only. Sandbox keys begin pdl_sdbx_apikey_; live keys begin pdl_live_apikey_.
# The production runtime key needs `price.read`, `customer.write`,
# `transaction.write`, `subscription.write`, and
# `customer_portal_session.write`; write includes read for the same entity.
# It must not have `adjustment.write`, so website code cannot create refund or
# credit adjustments. Keep notification-setting/client-token administration
# on a separate offline key that is never loaded into the production website.
# Keep every key server-only and rotate it when permissions change.
PADDLE_API_KEY=
# Server-only notification destination secret. Never expose this in NEXT_PUBLIC_*.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
# Browser-safe Paddle.js token. Sandbox begins test_; live begins live_.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server-readable runtime mirror of the same browser-safe token. Required for
# standalone images built off-host; the single-VM Compose file maps it from
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN automatically.
PADDLE_CLIENT_TOKEN=
# Set this only when a trusted reverse proxy overwrites X-Forwarded-For before
# the request reaches Next.js. The production Caddy service satisfies this.
PADDLE_TRUST_X_FORWARDED_FOR=false
# Current Live catalog base prices: USD, no country overrides, and no free trial.
# Paddle.PricePreview does not force USD or format prices app-side. Automatic
# conversions are managed in the Live Paddle dashboard and currently cover
# CAD, CNY, EUR, HKD, JPY, KRW, and USD.
# Free $0/month (read-only); Pro $69/month; Annual $699/year.
# One pro_ and one current pri_ ID per public tier. Old immutable annual and
# Advanced prices remain preserved in Paddle history for existing customers.
PADDLE_PRODUCT_FREE=
PADDLE_PRICE_FREE_MONTH=
PADDLE_PRODUCT_PRO=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRODUCT_ANNUAL=
PADDLE_PRICE_ANNUAL_YEAR=
# Historical Paddle entities stay active for reconciliation and existing buyers.
PADDLE_PRODUCT_STARTER=
PADDLE_PRICE_STARTER_MONTH=
PADDLE_PRICE_LEGACY_PRO_MONTH=
PADDLE_PRODUCT_LIFETIME=
PADDLE_PRICE_LIFETIME=
# Required only when intentionally running `npm run paddle:catalog` against
# Live, after Paddle has approved the actual AXIO7 product and domain.
PADDLE_CATALOG_CREATE_CONFIRM=
# Required only when intentionally provisioning the permanent Live client token
# and webhook destination with `npm run paddle:live-infra`.
PADDLE_LIVE_INFRA_CONFIRM=
# Optional identifier returned after the permanent destination is created.
PADDLE_NOTIFICATION_SETTING_ID=
# Sandbox purchases must not grant normal production access.
PADDLE_ALLOW_SANDBOX_ACCESS=false

# --- Market Strategy Intelligence ---
# Use only public, licensed, vendor-provided, or explicitly authorized sources.
# Do not configure scrapers that bypass login, paywalls, CAPTCHA, robots.txt, private groups, or API terms.
# SEC fair-access identity is configured once in the quant block below.

# Reuters / LSEG Data Platform News API. Requires commercial entitlements.
LSEG_CLIENT_ID=
LSEG_CLIENT_SECRET=
LSEG_NEWS_QUERY=

# Market tape + company news provider. Replace adapter with Polygon/IEX/Databento if preferred.
FINNHUB_API_KEY=

# Broad market news fallback.
NEWSAPI_KEY=
MARKET_NEWS_QUERY=

# Official X API v2. Used for recent search / influencer monitoring.
X_BEARER_TOKEN=

# Truth Social has no public official developer API. Use only licensed vendor/webhook access.
TRUTH_SOCIAL_PROVIDER_URL=
TRUTH_SOCIAL_PROVIDER_KEY=

# Strategy source universe and cron.
MARKET_STRATEGY_WATCHLIST=NVDA,AMD,TSLA,PLTR,COIN,MSFT,AVGO
MARKET_STRATEGY_QUERY="Reuters breaking news, X influencer posts, Truth Social provider events, AI chips, Tesla, crypto, Fed rates, unusual market tape"
MARKET_CRON_SECRET=

# --- Technical indicator station (KDJ low-zone golden cross) ---
# To scan the whole market, point this at a licensed/authorized universe service
# (Moomoo/Futu wrapper, Polygon, Nasdaq screener export, or your own endpoint).
# Accepted formats: JSON array, { "symbols": [...] }, { "tickers": [...] }, or CSV with a symbol/ticker/code column.
TECHNICAL_UNIVERSE_URL=
TECHNICAL_UNIVERSE_AUTH_HEADER=
# Quick fallback for a hand-maintained universe. Used before TECHNICAL_UNIVERSE_URL.
TECHNICAL_SCAN_UNIVERSE=
TECHNICAL_SCAN_DEFAULT_LIMIT=80
TECHNICAL_SCAN_MAX_PER_REQUEST=250

# Influencer exact handles. Do not fuzzy-match identity in production.
INFLUENCER_SERENITY_X=
INFLUENCER_SERENITY_TRUTH=
INFLUENCER_BREAD_X=
INFLUENCER_BREAD_TRUTH=
INFLUENCER_LABUBU_X=
INFLUENCER_LABUBU_TRUTH=
INFLUENCER_ELON_X=elonmusk
INFLUENCER_ELON_TRUTH=

# Optional options-flow vendor adapter key.
OPTIONS_FLOW_API_KEY=
# Set true after OPENAI_API_KEY / OPENAI_BASE_URL are valid.
MARKET_LLM_ENABLED=false

# Paper broker (industrial-grade simulator). Live broker stays disabled by design.
PAPER_BROKER_STARTING_CASH=100000
PAPER_RISK_PER_TRADE_PCT=1
BROKER_LIVE_ENABLED=false

# Rate limits (per IP + route). 0 windowMs disables the bucket on next request.
MARKET_RESEARCH_RATE_LIMIT=30
MARKET_RESEARCH_RATE_WINDOW_MS=60000
STRATEGY_EXECUTE_RATE_LIMIT=12
STRATEGY_EXECUTE_RATE_WINDOW_MS=60000

# --- Polygon.io (https://polygon.io) ---
POLYGON_API_KEY=

# --- Reddit OAuth (https://www.reddit.com/prefs/apps) ---
# Create a "script" app; the client_credentials grant is sufficient for read-only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="AXIO7-MarketIntel/1.0 by your-reddit-username"
REDDIT_SUBS=wallstreetbets,options,stocks,investing,SPACs,cryptocurrency

# --- BYO Broker keys (per-user, encrypted with AES-256-GCM) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BROKER_ENCRYPTION_KEY=

# Live execution gate. Keep false until compliance review (RIA / non-RIA disclosure)
# is complete. With this off, /api/strategy/confirm-execute will refuse all live orders
# even if the user has a live broker key on file.
LIVE_EXECUTION_ENABLED=false

# --- Trade connection email (Resend) ---
# Install Resend from Vercel Marketplace or create a key at https://resend.com.
# EMAIL_FROM must use a verified domain in production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="AXIO7 Trade <trade@axio7.com>"

# --- Google Analytics 4 (free) ---
# Create property at https://analytics.google.com → Admin → Create property
# Copy the Measurement ID (starts with G-), paste below, and set the same var on Vercel.
# Leave empty to disable tracking.
NEXT_PUBLIC_GA_ID=
# Optional: Looker Studio report URL to embed on /admin/analytics.
# Build a report from your GA4 data at https://lookerstudio.google.com,
# click Share → Embed report → paste the /embed/reporting/... URL here.
NEXT_PUBLIC_LOOKER_STUDIO_EMBED=

# --- Redis (LangGraph checkpointing) ---
# Get free Redis from: Vercel Dashboard → Storage → Upstash Redis
# Or any Redis-compatible: redis://default:password@host:port
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:PORT

# --- Portrait Background Removal ---
# Priority 1: Clipdrop (free 100 calls/month, email signup only, no phone)
#   Sign up: https://clipdrop.co/apis → Create API key (free tier)
#   Paid: $0.05-0.10/call, scales to millions
CLIPDROP_API_KEY=

# Priority 2: remove.bg (free 50 calls/month, best for portraits/hair detail)
#   Sign up: https://www.remove.bg/api
REMOVEBG_API_KEY=

# Priority 3: Photoroom (free tier available, good for complex backgrounds)
#   Sign up: https://www.photoroom.com/api
PHOTOROOM_API_KEY=

# System picks best quality result automatically (qualityMode: best).
# For production: set all three for redundancy and automatic quality fallback.
# Provider order: removebg → photoroom → clipdrop (most to least portrait-optimized).

# --- Bot auto-posting + cron auth ---
# Random string used to authenticate Vercel cron requests to /api/bot/post, /api/cron/ingest-events,
# /api/cron/agent-autopost, /api/cron/agent-autoreply, /api/cron/agent-summary
# Generate one with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# --- Autonomous Agent Feed ---
# Phase 1+2+3: agents post and reply autonomously when humans aren't active.
# Default: all false (safe for production). Enable gradually.
# Set AGENT_AUTONOMOUS_ENABLED=true to unlock all autonomous features.
AGENT_AUTONOMOUS_ENABLED=false

# --- Agent Discussion Engine ---
# Agents auto-continue discussion on posts (multi-round, agent-to-agent)
# Default off. Enable after running migration 010.
AGENT_DISCUSSIONS_ENABLED=false
MAX_DISCUSSION_ROUNDS_PER_POST=5
MAX_AGENT_DISCUSSION_REPLIES_PER_ROUND=4
MAX_TOTAL_AGENT_REPLIES_PER_POST=40
MAX_AGENT_DISCUSSION_REPLIES_PER_HOUR=200
# Autonomous scan settings
DISCUSSION_SCAN_POSTS_PER_RUN=15
DISCUSSION_MAX_POSTS_PER_RUN=5
AGENT_AUTONOMOUS_POSTS_ENABLED=false
AGENT_AUTONOMOUS_REPLIES_ENABLED=false
AGENT_AGENT_TO_AGENT_ENABLED=false
AGENT_FEED_SUMMARY_ENABLED=false
AGENT_TRADE_CONTEXT_ENABLED=false

# Global daily caps (failsafe, checked before every generation)
MAX_AUTONOMOUS_POSTS_PER_DAY=30
MAX_AUTONOMOUS_REPLIES_PER_DAY=100
MAX_AUTONOMOUS_POSTS_PER_AGENT_PER_DAY=5
MAX_AUTONOMOUS_REPLIES_PER_AGENT_PER_DAY=20
MAX_AGENT_REPLIES_PER_THREAD=6

# --- AWS deployment helpers ---
# Do not commit real AWS credentials.
AWS_REGION=us-east-1

# --- Events Discovery ---
# Secret for /api/events/ingest (manual or Vercel Cron). Falls back to CRON_SECRET if unset.
EVENT_INGEST_SECRET=

# Ticketmaster Discovery API — free tier: https://developer.ticketmaster.com
# Without this key, the Ticketmaster source is skipped gracefully.
TICKETMASTER_API_KEY=

# Columbia events JSON feed URLs (comma-separated).
# Accepts iCal or JSON feeds from events.columbia.edu.
# Defaults to the official public iCal endpoint if not set.
COLUMBIA_EVENTS_JSON_URLS=

# --- Global Quant Signal Radar (professional low-latency sources) ---
# Dashboard: /quant/global-signals
# API: /api/quant/global-signals
# Do not use delayed retail data as the primary intraday alert source.

# --- Native market-query API (Rust/Axum; no Python/TypeScript inference) ---
# Public chat traffic compiles to axio.market-query.v1 and reaches Rust through
# /api/ask or the narrow /api/quant/research proxy. Admin control-plane traffic
# remains isolated under /api/quant/intraday/*.
INTRADAY_QUANT_API_URL=http://127.0.0.1:8001
# Local-only opt-in for the held-out historical research endpoint. Production
# deployments must leave this unset/false.
AXIO_ENABLE_HISTORICAL_REPLAY=0
# Optional isolated local debug backend for historical replay. Keeping this
# separate lets the optimized live backend remain on INTRADAY_QUANT_API_URL.
HISTORICAL_REPLAY_API_URL=
# Databento key is configured in the provider block below; never expose it to the browser.
# Required for every quant control-plane read or mutation except `/health`.
# Use at least 32 random characters and keep it on the server only.
INTRADAY_QUANT_TOKEN=
# Server-only credential for /api/cron/market-monitors. Falls back to
# CRON_SECRET when omitted.
MARKET_MONITOR_CRON_SECRET=
# Explicit quant control-plane administrators. General app admin defaults do
# not grant access unless the same verified email is listed here.
QUANT_ADMIN_EMAILS=
# Separate credential required to release the risk kill switch. Do not reuse
# INTRADAY_QUANT_TOKEN.
RISK_APPROVAL_TOKEN=
# SHA-256 of models/predictor_promotion_latest.json. Allocation remains
# NO_TRADE unless the active promotion registry is externally pinned here.
MODEL_PROMOTION_REGISTRY_SHA256=
# Required for SEC EDGAR. Include AXIO7 plus a real monitored contact email;
# placeholder/example domains are rejected by the public route and SEC sync.
SEC_USER_AGENT=
# Optional comma-separated customer-route symbol allowlist. Empty uses the
# reviewed built-in list.
AXIO7_PUBLIC_CONTEXT_SYMBOLS=
# FRED/ALFRED is unsupported by the official sync under current terms; no FRED
# credential is accepted. Use the direct BLS, Treasury, and NY Fed adapters.
SEC_API_KEY=
BENZINGA_API_KEY=
BUSINESSWIRE_API_KEY=
PRNEWSWIRE_API_KEY=
GLOBENEWSWIRE_API_KEY=
NASDAQ_TOTALVIEW_API_KEY=
NASDAQ_TOTALVIEW_WS_URL=
NASDAQ_TOTALVIEW_ENABLED=false
OPRA_VENDOR=
INTRINIO_API_KEY=
CBOE_LIVEVOL_API_KEY=
DATABENTO_API_KEY=
POLYGON_API_KEY=
# Production live adapter. Requires a plan entitled to the real-time U.S.
# consolidated SIP stock WebSocket and real-time OPRA option-chain snapshots.
# A delayed/basic plan is detected and rejected; the key is never sent to UI.
MASSIVE_API_KEY=
# Optional future broker-data adapter. Tradier production market data is
# realtime/consolidated only for eligible Tradier Brokerage account holders;
# sandbox is delayed and must never satisfy the realtime gate. The current
# production runtime does not consume this token until its Rust adapter and
# entitlement receipt are enabled.
TRADIER_ACCESS_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
# Optional, separately reviewed registry. A candidate produced by
# `quantctl predictor calibrate` is OOS-validated at most and cannot be used
# until its lifecycle is independently promoted and the exact path is set.
AXIO_PROBABILITY_CALIBRATION_ARTIFACT=
# Licensed Cboe DataShop/CGIF import root. Never point this at unlicensed files.
CBOE_DATA_ROOT=
# IBKR is forward archive + paper execution only; it cannot restore expired SPXW history.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=
IBKR_ACCOUNT=
CME_FUTURES_FEED_URL=
KRX_API_KEY=
KOREA_MARKET_FEED_URL=
IBKR_KOREA_MARKET_DATA_ENABLED=false
TRADING_ECONOMICS_KEY=
ECONODAY_API_KEY=
COINGLASS_API_KEY=
CRYPTO_EXCHANGE_WS_ENABLED=false
LSEG_CLIENT_ID=
LSEG_CLIENT_SECRET=
DOWJONES_API_KEY=
BLOOMBERG_API_KEY=
X_BEARER_TOKEN=

# Public first-source/context mesh.
# PUBLIC_OFFICIAL_RSS_FEEDS accepts comma/newline separated HTTPS RSS/Atom feeds.
# Use only official issuer, agency, exchange, or licensed public feeds.
PUBLIC_OFFICIAL_RSS_FEEDS=
TREASURY_OFFICIAL_FEED_URL=
WHITE_HOUSE_FEED_URL=
USTR_FEED_URL=
BLS_PUBLIC_API_ENABLED=false
BLS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=
NYT_API_KEY=
NYT_SIGNAL_QUERY="Federal Reserve OR Treasury OR sanctions OR tariffs OR Iran OR China OR Nvidia OR Meta OR semiconductors OR oil OR dollar"
JIN10_API_KEY=
JIN10_FEED_URL=

# IBKR is broker/account/execution truth, not the only signal feed.
IBKR_BASE_URL=
IBKR_ACCOUNT_ID=
IBKR_MARKET_DATA_ENABLED=false
IBKR_ALLOW_INSECURE_TLS=false
IBKR_ALLOW_INSECURE_TLS=false

# Moomoo / Futu OpenAPI.
# Default AXIO7 workflow is Moomoo manual execution: the site generates an order ticket/checklist,
# and you place the order yourself inside the Moomoo app/desktop.
EXECUTION_PRIMARY_PLATFORM=moomoo
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_MARKET_DATA_ENABLED=false
MOOMOO_TRADE_ENABLED=false
# Owner-only Rust shadow forecast relay. The local token and server token must
# match and contain at least 32 random characters. This does not authorize
# public/customer market-data display or remove model-promotion gates.
MOOMOO_FORECAST_RELAY_ENABLED=false
AXIO7_MOOMOO_FORECAST_RELAY_URL=
MOOMOO_FORECAST_RELAY_TOKEN=
# Local Rust <-> Moomoo trade gateway authentication. Generate separate random
# values and load them only into the local process environment. Never expose
# either token to the browser or commit a populated value.
AXIO_BROKER_GATEWAY_TOKEN=
AXIO_LIVE_ARMING_TOKEN=
# The exact phrase below is required only for a deliberately configured real
# gateway. Keep this disabled for simulation and forward-shadow operation.
AXIO_LIVE_TRADING_ENABLED=disabled
# Prefer the MD5 form supported by OpenD. Do not save a populated value here.
MOOMOO_TRADE_PASSWORD_MD5=
MOOMOO_TRADE_PASSWORD=

# Automatic warning delivery for /api/cron/global-signal-alerts.
# Keep disabled until at least one delivery target is configured.
GLOBAL_SIGNAL_ALERTS_ENABLED=false
GLOBAL_SIGNAL_ALERT_MIN_LEVEL=ORANGE
GLOBAL_SIGNAL_ALERT_MIN_SCORE=70
GLOBAL_SIGNAL_ALERT_COOLDOWN_MINUTES=30
GLOBAL_SIGNAL_ALERT_SECRET=
GLOBAL_SIGNAL_ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Price-led anomaly engine.
# Detects abnormal tape first, then attributes cause through filings/news/macro.
# Yahoo/delayed retail data is not used for anomaly alerts.
PRICE_ANOMALY_ENABLED=true
PRICE_ANOMALY_WATCHLIST=META,NVDA,AVGO,MU,SNDK,SMH,SOXX,QQQ
ANOMALY_AUTO_PAPER_ENABLED=false
ANOMALY_LIVE_ORDER_ENABLED=false

# --- Sentry (error monitoring — free) ---
# Sign up at https://sentry.io → New Project → Next.js
# DSN appears on the project settings page. Use NEXT_PUBLIC_ for client-side init.
# Server-only SENTRY_DSN is optional (defaults to NEXT_PUBLIC_SENTRY_DSN on server).
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXXX
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXXX
# Optional: enables source map uploads to Sentry at build time.
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# --- Langfuse (LLM call tracing — free self-hosted or cloud) ---
# Sign up at https://cloud.langfuse.com → Settings → API keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=
# Leave empty to use cloud.langfuse.com. Set to http://localhost:3001 for local.
LANGFUSE_HOST=https://cloud.langfuse.com

# --- PostHog (product analytics — free up to 1M events/mo) ---
# Sign up at https://app.posthog.com → Project Settings → API keys
# NEXT_PUBLIC_ keys are safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Public market-data authorization (server only; fail closed when empty) ---
AXIO7_PUBLIC_MARKET_DATA_PROVIDER=
AXIO7_PUBLIC_MARKET_DATA_LICENSE_REFERENCE=
# Local development only: permit the loopback Rust/Next runtime to render raw,
# uncalibrated model moments from the user's licensed Databento feed without
# asserting public redistribution rights. The backend must bind to loopback,
# remain shadow/quote-only, and keep every execution path disabled.
AXIO_ENABLE_LOCAL_UNCALIBRATED_LIVE_RESEARCH=false
