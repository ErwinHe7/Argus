www.{$AXIO7_DOMAIN:axio7.com} {
	redir https://{$AXIO7_DOMAIN:axio7.com}{uri} permanent
}

{$AXIO7_DOMAIN:axio7.com} {
	encode zstd gzip
	reverse_proxy quantd:3000

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}
