# Copy to .env.server on the VM. Never commit the populated file.
AXIO7_DOMAIN=axio7.com
NEXT_PUBLIC_SITE_URL=https://axio7.com
AXIO7_SITE_URL=https://axio7.com
BILLING_PROVIDER=paddle
# Set this to the exact 40-character commit used to build both production
# images. A blank value makes Compose configuration fail before a build.
GIT_COMMIT=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generate separate values, each at least 32 characters:
#   openssl rand -hex 32
INTRADAY_QUANT_TOKEN=
MARKET_MONITOR_CRON_SECRET=

# Optional LLM explanation layer. Quantitative results still come from Rust.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave empty until a provider has granted the required realtime and public-use
# rights. Empty or insufficient entitlement makes live research fail closed.
MASSIVE_API_KEY=
DATABENTO_API_KEY=
AXIO7_PUBLIC_MARKET_DATA_PROVIDER=
AXIO7_PUBLIC_MARKET_DATA_LICENSE_REFERENCE=
AXIO7_MARKET_DATA_RIGHTS_RECEIPT_SHA256=
# Private TLS PostgreSQL archive. The scope must exactly match the pinned
# rights receipt; there is no permissive default. The standalone VM uses the
# separate password below without exposing PostgreSQL publicly. A managed TLS
# URL may override the internal connection for a later RDS migration.
MARKET_POSTGRES_PASSWORD=
MARKET_DATABASE_URL=
AXIO7_MARKET_DATA_LICENSE_SCOPE=
MODEL_PROMOTION_REGISTRY_SHA256=
# JSON object keyed by SYMBOL@MODEL_SHA256. This is an independent external
# pin for every v2 promotion entry; an empty value keeps publication blocked.
MODEL_PROMOTION_ENTRY_SHA256_PINS=
AXIO_PROBABILITY_CALIBRATION_ARTIFACT=data/calibration/probability_calibration_latest.json
AXIO_PROBABILITY_CALIBRATION_SHA256=

# Owner-only IBKR market data. The gateway is quote-only at the AXIO7 app
# boundary; all execution flags below remain false.
IBKR_BASE_URL=https://ibkr-gateway:5000/v1/api
IBKR_ACCOUNT_ID=
IBKR_MARKET_DATA_ENABLED=true
IBKR_ALLOW_INSECURE_TLS=true

# Local Gateway quotes use an outbound-only, quote-only relay. Generate a
# distinct random 32+ character token; never reuse an IBKR or vendor secret.
IBKR_QUOTE_RELAY_ENABLED=false
IBKR_QUOTE_RELAY_TOKEN=

# Owner-only Moomoo forecast relay. This accepts only fail-closed Rust
# forward-shadow or deterministic-replay receipts; it does not grant public
# market-data redistribution rights. Generate a distinct 32+ character token.
MOOMOO_FORECAST_RELAY_ENABLED=false
MOOMOO_FORECAST_RELAY_TOKEN=

# Optional product services.
# Paddle Live is the permanent production billing path. The three current
# products and prices below are required and must remain distinct. Free and
# Pro recur monthly; Annual recurs yearly.
PADDLE_ENVIRONMENT=live
PADDLE_API_KEY=pdl_live_apikey_REPLACE_ME
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_REPLACE_ME
PADDLE_CLIENT_TOKEN=live_REPLACE_ME
PADDLE_TRUST_X_FORWARDED_FOR=true
PADDLE_ALLOW_SANDBOX_ACCESS=false
PAYMENTS_ALLOW_TEST_ACCESS=false
PADDLE_PRODUCT_FREE=pro_REPLACE_WITH_26_LOWERCASE_ALNUM
PADDLE_PRICE_FREE_MONTH=pri_REPLACE_WITH_26_LOWERCASE_ALNUM
PADDLE_PRODUCT_PRO=pro_REPLACE_WITH_26_LOWERCASE_ALNUM
PADDLE_PRICE_PRO_MONTH=pri_REPLACE_WITH_26_LOWERCASE_ALNUM
PADDLE_PRODUCT_ANNUAL=pro_REPLACE_WITH_26_LOWERCASE_ALNUM
PADDLE_PRICE_ANNUAL_YEAR=pri_REPLACE_WITH_26_LOWERCASE_ALNUM
# Preserved legacy catalog IDs for existing subscriptions and lifetime access.
PADDLE_PRODUCT_STARTER=
PADDLE_PRICE_STARTER_MONTH=
PADDLE_PRICE_LEGACY_PRO_MONTH=
PADDLE_PRODUCT_LIFETIME=pro_REPLACE_WITH_26_LOWERCASE_ALNUM
PADDLE_PRICE_LIFETIME=pri_REPLACE_WITH_26_LOWERCASE_ALNUM
# Optional historical price IDs are accepted only so existing legacy Paddle
# subscriptions can keep reconciling through verified webhooks. They are not
# part of current catalog completeness and must never replace the six current IDs above.
PADDLE_PRICE_STARTER_YEAR=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_ADVANCED_MONTH=
PADDLE_PRICE_ADVANCED_YEAR=
PADDLE_NOTIFICATION_SETTING_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Execution is deliberately disabled in this public research deployment.
LIVE_EXECUTION_ENABLED=false
BROKER_LIVE_ENABLED=false
ANOMALY_LIVE_ORDER_ENABLED=false
