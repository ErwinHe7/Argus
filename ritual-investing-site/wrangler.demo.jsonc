{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ritual-investing-demo",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "demo.just-build-this.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/demo",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
