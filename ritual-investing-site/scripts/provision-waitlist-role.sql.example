\set ON_ERROR_STOP on

-- Invoke separately in each dedicated production/beta waitlist project. Feed
-- the two psql variables through an approved secret-safe operator mechanism;
-- do not enable psql echoing or place credentials in shell history.
\if :{?runtime_password}
\else
  \echo 'runtime_password is required'
  \quit 3
\endif
\if :{?maintenance_password}
\else
  \echo 'maintenance_password is required'
  \quit 3
\endif

BEGIN;

-- Neon managed owners cannot ALTER ROLE. Create these environment-local
-- credential capabilities once, with their final attributes and passwords.
CREATE ROLE waitlist_runtime
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT LOGIN NOREPLICATION NOBYPASSRLS
  PASSWORD :'runtime_password';
CREATE ROLE waitlist_maintenance
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT LOGIN NOREPLICATION NOBYPASSRLS
  PASSWORD :'maintenance_password';
REVOKE waitlist_runtime FROM waitlist_maintenance;
REVOKE waitlist_maintenance FROM waitlist_runtime;

-- Apply the reviewed migration next. It creates the NOLOGIN function owner,
-- validates these attributes, and grants only the reviewed capabilities.
COMMIT;
