{
  "name": "@ritual-investing/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "assets:build": "node --experimental-strip-types scripts/build-assets.ts",
    "assets:build:release": "REQUIRE_WAITLIST_CONFIGURATION=true node --experimental-strip-types scripts/build-assets.ts",
    "pages:config:check": "vitest run test/config.test.ts test/build-assets.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
